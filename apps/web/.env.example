# demo = explicitly labeled fixtures. sanity = live published content only.
CONTENT_MODE=sanity
SITE_URL=http://localhost:4320
SANITY_PROJECT_ID=vjmj7stb
SANITY_DATASET=helpcenterdevelopment
SANITY_API_VERSION=2025-02-19
# Optional, server-only, least-privilege read token for a private dataset.
SANITY_READ_TOKEN=
# Configure ANTHROPIC_API_KEY only in a server environment, never in this template.
# Enable only after provisioning the database and configuring abuse protection.
HELP_CHAT_ENABLED=false
# Optional aggregate request metrics in server logs, without chat content.
HELP_CHAT_METRICS=false
# Set HELP_CHAT_DATABASE_URL in the server environment, not this template.
# Provision scripts/help-chat-quota.sql first. Non-local databases require sslmode=verify-full.
HELP_CHAT_REQUESTS_PER_MINUTE=1000
HELP_CHAT_REQUESTS_PER_DAY=10000
# Optional approved support email for the support page mailto link (no ticket form).
# Leave blank to show the support-unavailable message.
# Example: support@movingwalls.com
SUPPORT_EMAIL=
# Optional local SQLite path in a dedicated private directory (never public/).
# Demo defaults to apps/web/data/helpfulness-demo.sqlite when launched via pnpm.
# Sanity mode: blank disables feedback; production needs a persistent local disk.
FEEDBACK_DB_PATH=