# demo = explicitly labeled fixtures. sanity = live published content only.
CONTENT_MODE=demo
SITE_URL=http://localhost:4320
SANITY_PROJECT_ID=
SANITY_DATASET=development
SANITY_API_VERSION=2025-02-19
# Optional, server-only, least-privilege read token for a private dataset.
SANITY_READ_TOKEN=
# Optional approved support email for the support page mailto link (no ticket form).
# Leave blank to show the support-unavailable message.
# Example: support@movingwalls.com
SUPPORT_EMAIL=
# Optional local SQLite path in a dedicated private directory (never public/).
# Demo defaults to apps/web/data/helpfulness-demo.sqlite when launched via pnpm.
# Sanity mode: blank disables feedback; production needs a persistent local disk.
FEEDBACK_DB_PATH=