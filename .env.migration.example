# Copy to the ignored root .env.migration file. Never commit actual credentials.
# Create an Atlassian API token with read access to the Helpdesk space.
CONFLUENCE_BASE_URL=https://movingwallshub.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Create a Sanity token with write access to the development dataset only.
# This importer always creates drafts and refuses any other project/dataset.
SANITY_PROJECT_ID=vjmj7stb
SANITY_DATASET=helpcenterdevelopment
SANITY_MIGRATION_TOKEN=