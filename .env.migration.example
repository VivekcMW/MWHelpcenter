# Copy to the ignored root .env.migration file. Never commit actual credentials.
# Create an Atlassian API token with read access to the Helpdesk space.
CONFLUENCE_BASE_URL=https://movingwallshub.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=

# Create a Sanity token with write access to the development dataset only.
# This importer always creates drafts and refuses any other project/dataset.
SANITY_PROJECT_ID=vjmj7stb
SANITY_DATASET=helpcenterdevelopment
SANITY_MIGRATION_TOKEN=

# Confluence sync service. Use a private managed-PostgreSQL connection string.
# Require TLS in the provider connection string; never expose these to the web client.
DATABASE_URL=
# Configure the matching secret in Confluence's webhook settings (32+ characters).
CONFLUENCE_WEBHOOK_SECRET=
# The service listens on PORT when supplied by its host, otherwise this value.
CONFLUENCE_SYNC_PORT=8080
# Set false to durably buffer webhook events while the initial import is reviewed.
CONFLUENCE_SYNC_WORKER_ENABLED=true
